# --- Database ---
# PostgreSQL connection string (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@localhost:5432/polished

# --- Shopify ---
# From your Shopify Partner app (Settings > API credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated, no spaces
SHOPIFY_SCOPES=read_products,write_products,read_translations,write_translations
# Public HTTPS URL of this app (no trailing slash). e.g. https://polished.up.railway.app
SHOPIFY_APP_URL=https://your-app-url.example.com

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-4-6 (native-quality Polish).
# Use claude-haiku-4-5 to cut cost on very large catalogs.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Billing ---
# Set to "true" to enforce the Shopify subscription, "false" to disable billing entirely
BILLING_ENABLED=false

# --- Runtime ---
NODE_ENV=production
# Railway injects PORT automatically; defaults to 3000 locally
PORT=3000
